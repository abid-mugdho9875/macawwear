# ---------- Server-side (Netlify Functions) ----------
# Supabase PostgreSQL connection string. Use the "Transaction pooler" URL from
# Supabase → Project Settings → Database. NEVER expose this to the frontend.
DATABASE_URL='postgresql://postgres.yvbvjcgthmannkabueej:WvxLafrqtm1CJVgh@aws-0-ap-south-1.pooler.supabase.com:6543/postgres'

# ── Optional: order confirmation email ──
# If you leave RESEND_API_KEY / EMAIL_FROM blank, the function still saves
# orders to Supabase — it just doesn't send an email. Use the order table in
# Supabase to fulfil orders manually until you wire up Resend.

# Resend API key (https://resend.com/api-keys). NEVER expose this to the frontend.
RESEND_API_KEY=

# Verified "from" address Resend is allowed to send from, e.g. "orders@example.com".
EMAIL_FROM=

# Display name used as the "From name" for transactional emails.
COMPANY_NAME=

# ---------- Frontend (Vite, VITE_* are exposed to the browser) ----------
# Optional. Leave blank to use same-origin relative paths (/.netlify/functions/...).
VITE_API_URL=